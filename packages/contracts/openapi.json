                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logOut",
        "summary": "Cierra la sesión actual",
        "tags": [
          "identity"
        ],
        "responses": {
          "204": {
            "description": "Cierra la sesión actual"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me",
        "summary": "Usuario de la sesión actual",
        "tags": [
