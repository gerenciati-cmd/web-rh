{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm test)",
      "Bash(pnpm test:harness)",
      "Bash(pnpm test:integration)",
      "Bash(pnpm plans:status)",
      "Bash(pnpm plans:lint)",
      "Bash(pnpm plans:scope *)",
      "Bash(pnpm harness:sync)",
      "Bash(pnpm harness:check)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm arch:check)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:up)",
      "Bash(pnpm db:logs)",
      "Bash(pnpm --filter @rrhh/* typecheck)",
      "Bash(pnpm --filter @rrhh/* lint)",
      "Bash(pnpm --filter @rrhh/* test)",
      "Bash(pnpm --filter @rrhh/* build)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prisma generate)",
      "Bash(pnpm exec prisma validate)",
      "Bash(pnpm exec prisma format)",
      "Bash(pnpm exec turbo *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(docker compose -f infra/docker/docker-compose.yml ps)",
      "Bash(docker compose -f infra/docker/docker-compose.yml logs *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm --filter * add *)",
      "Bash(pnpm --filter * remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:down)",
      "Bash(docker *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(prisma migrate reset *)",
      "Bash(pnpm exec prisma migrate reset *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-files.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.mjs",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  }
}
