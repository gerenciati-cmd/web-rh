# ── Runtime ──────────────────────────────────
NODE_ENV=development
PORT=3001
# debug muestra también el sondeo de los checadores
LOG_LEVEL=info
# Orígenes permitidos por CORS, separados por coma. `http://localhost:3001` es el propio API:
# permite probar el login web (cookie) desde la referencia /api/v1/docs.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:3001

# ── Base de datos (ver infra/docker/docker-compose.yml) ──
DATABASE_URL=postgresql://rrhh:rrhh@localhost:5432/rrhh
# Base SOLO para tests de integración (`pnpm test:integration`). Debe terminar en _test.
DATABASE_URL_TEST=postgresql://rrhh:rrhh@localhost:5432/rrhh_test

# ── Colas / caché ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Sesiones y login ──────────────────────────
SESSION_WEB_IDLE_MINUTES=30
SESSION_WEB_ABSOLUTE_HOURS=12
SESSION_MOBILE_ABSOLUTE_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=50
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15
# ── Correo saliente (en desarrollo: Mailpit, UI en http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Vacío = sin autenticación.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RRHH APS <no-reply@example.com>"
# Base de los enlaces de los correos (la pantalla /activar aún no existe: plan 004).
APP_PUBLIC_URL=http://localhost:3000
# Vigencia de una invitación, en horas (168 = 7 días).
INVITATION_TTL_HOURS=168
# Vigencia del enlace de restablecer contraseña, en minutos (60 = 1 hora).
PASSWORD_RESET_TTL_MINUTES=60
# Espera mínima entre dos solicitudes de "olvidé mi contraseña" del mismo usuario, en segundos (180 = 3 minutos).
PASSWORD_RESET_COOLDOWN_SECONDS=180

# Contraseña del usuario admin@example.com que crea `pnpm db:seed`; vacío = no se crea.
SEED_USER_PASSWORD=
