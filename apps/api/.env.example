# ── Runtime ──────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Base de datos (ver infra/docker/docker-compose.yml) ──
DATABASE_URL=postgresql://rrhh:rrhh@localhost:5432/rrhh
# Base SOLO para tests de integración (`pnpm test:integration`). Debe terminar en _test.
DATABASE_URL_TEST=postgresql://rrhh:rrhh@localhost:5432/rrhh_test

# ── Colas / caché ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Dispositivos ZKTeco (ADMS) ───────────────
# Números de serie autorizados a enviar datos, separados por coma. Vacío = ninguno.
ZKTECO_ALLOWED_SERIALS=
