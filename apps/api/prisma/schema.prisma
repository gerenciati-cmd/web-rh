// ─────────────────────────────────────────────────────────────────────────────
// Esquema de persistencia. SOLO lo conoce la capa `infrastructure/` de cada módulo.
//
// Reglas:
//  • Un schema de Postgres por módulo (@@schema). Refleja las fronteras del monolito modular.
//  • SIN relaciones/foreign keys entre módulos: se referencian por id (uuid).
//    Así un módulo puede extraerse a otro servicio sin desarmar la base.
//  • Tablas y columnas en snake_case (@@map / @map); modelos Prisma en PascalCase.
//  • Nunca editar una migración ya aplicada: crear una nueva.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["organization", "employees", "identity", "attendance"]
}

// ── Módulo: organization ────────────────────────────────────────────────────

model Company {
  id        String   @id @db.Uuid
  legalName String   @map("legal_name") @db.VarChar(200)
  taxId     String   @map("tax_id") @db.VarChar(20)
  country   String   @db.Char(2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([country, taxId])
  @@map("companies")
  @@schema("organization")
}

// ── Módulo: employees ───────────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  TERMINATED

  @@schema("employees")
}

model Employee {
  id                String         @id @db.Uuid
  /// Referencia por id al módulo organization (sin FK a propósito).
  companyId         String         @map("company_id") @db.Uuid
  nationalIdCountry String         @map("national_id_country") @db.Char(2)
  nationalIdNumber  String         @map("national_id_number") @db.VarChar(20)
  firstName         String         @map("first_name") @db.VarChar(100)
  lastName          String         @map("last_name") @db.VarChar(100)
  email             String         @db.VarChar(254)
  positionTitle     String?        @map("position_title") @db.VarChar(150)
  hireDate          DateTime       @map("hire_date") @db.Date
  status            EmployeeStatus @default(ACTIVE)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, nationalIdCountry, nationalIdNumber])
  @@index([companyId, status])
  @@map("employees")
  @@schema("employees")
}

// ── Módulo: identity ────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED

  @@schema("identity")
}

enum SessionClient {
  WEB
  MOBILE

  @@schema("identity")
}

model User {
  id           String     @id @db.Uuid
  email        String     @unique @db.VarChar(254)
  passwordHash String     @map("password_hash") @db.Text
  status       UserStatus @default(ACTIVE)
  /// referencia por id a employees, sin FK (ADR 0010)
  employeeId   String?    @unique @map("employee_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  roleAssignments RoleAssignment[]
  passwordResets  PasswordReset[]

  @@map("users")
  @@schema("identity")
}

model Session {
  id                 String        @id @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  user               User          @relation(fields: [userId], references: [id])
  tokenHash          String        @unique @map("token_hash") @db.Char(64)
  client             SessionClient
  createdAt          DateTime      @map("created_at") @db.Timestamptz(3)
  lastSeenAt         DateTime      @map("last_seen_at") @db.Timestamptz(3)
  expiresAt          DateTime      @map("expires_at") @db.Timestamptz(3)
  idleTimeoutSeconds Int?          @map("idle_timeout_seconds")
  revokedAt          DateTime?     @map("revoked_at") @db.Timestamptz(3)
  ip                 String?       @db.VarChar(45)
  userAgent          String?       @map("user_agent") @db.VarChar(500)

  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}

model Invitation {
  id         String    @id @db.Uuid
  email      String    @db.VarChar(254)
  /// referencia por id a employees, sin FK (ADR 0010)
  employeeId String?   @map("employee_id") @db.Uuid
  /// referencia por id a organization, sin FK (ADR 0010)
  companyId  String?   @map("company_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  invitedBy  String    @map("invited_by") @db.Uuid
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([employeeId])
  @@index([email])
  @@map("invitations")
  @@schema("identity")
}

model PasswordReset {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  /// `null` = lo pidió el propio usuario; un id = lo forzó el personal
  requestedBy String?   @map("requested_by") @db.Uuid
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_resets")
  @@schema("identity")
}

enum IdentityRole {
  HOLDING_ADMIN
  HR
  DIRECT_MANAGER
  EMPLOYEE

  @@schema("identity")
}

model RoleAssignment {
  id         String       @id @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id])
  role       IdentityRole
  /// Referencia por id a organization, sin FK (ADR 0010). null = todo el holding.
  companyId  String?      @map("company_id") @db.Uuid
  assignedAt DateTime     @map("assigned_at") @db.Timestamptz(3)
  assignedBy String?      @map("assigned_by") @db.Uuid
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokedBy  String?      @map("revoked_by") @db.Uuid

  @@index([userId, revokedAt])
  @@index([role, revokedAt])
  @@map("role_assignments")
  @@schema("identity")
}

model LoginThrottle {
  key             String    @id @db.VarChar(320)
  failures        Int
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)

  @@map("login_throttles")
  @@schema("identity")
}

// ── Módulo: attendance ──────────────────────────────────────────────────────

model AttendanceDevice {
  id           String            @id @db.Uuid
  serialNumber String            @unique @map("serial_number") @db.VarChar(64)
  name         String            @db.VarChar(100)
  timeZone     String            @map("time_zone") @db.VarChar(64)
  active       Boolean           @default(true)
  registeredAt DateTime          @map("registered_at") @db.Timestamptz(3)
  lastSeenAt   DateTime?         @map("last_seen_at") @db.Timestamptz(3)
  punches      AttendancePunch[]

  @@map("devices")
  @@schema("attendance")
}

model AttendancePunch {
  id              String           @id @db.Uuid
  deviceId        String           @map("device_id") @db.Uuid
  /// Mismo módulo: la FK al equipo está permitida.
  device          AttendanceDevice @relation(fields: [deviceId], references: [id])
  pin             String           @db.VarChar(32)
  /// Hora de pared del equipo tal como llegó (`YYYY-MM-DD HH:mm:ss`), sin zona.
  deviceLocalTime String           @map("device_local_time") @db.Char(19)
  occurredAt      DateTime         @map("occurred_at") @db.Timestamptz(3)
  status          String           @db.VarChar(16)
  verifyMode      String           @map("verify_mode") @db.VarChar(16)
  receivedAt      DateTime         @map("received_at") @db.Timestamptz(3)

  @@unique([deviceId, pin, deviceLocalTime])
  @@index([deviceId, occurredAt])
  @@index([occurredAt])
  @@map("punches")
  @@schema("attendance")
}
