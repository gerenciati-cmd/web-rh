{
  "name": "@rrhh/api",
  "version": "0.0.0",
  "private": true,
  "description": "API HTTP + worker. Monolito modular con arquitectura hexagonal y CQRS ligero.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main/http.ts",
    "dev:worker": "tsx watch --clear-screen=false src/main/worker.ts",
    "build": "tsup",
    "start": "node dist/http.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@rrhh/contracts": "workspace:*",
    "@rrhh/domain": "workspace:*",
    "@scalar/express-api-reference": "0.10.23",
    "awilix": "13.0.5",
    "bullmq": "6.3.9",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rrhh/eslint-config": "workspace:*",
    "@rrhh/tsconfig": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "catalog:",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "prisma"
  ]
}
